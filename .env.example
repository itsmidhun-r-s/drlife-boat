# In dev, "/api" goes through the Vite proxy (see vite.config.ts) -> no CORS / cookie problems.
# In production set the full backend URL, e.g. https://api.drlifeboat.com/api
VITE_API_URL=/api
# Optional - the backend already sends the Razorpay key id with each order
VITE_RAZORPAY_KEY_ID=
VITE_APP_NAME=DrLifeBoat
VITE_APP_URL=http://localhost:3000
